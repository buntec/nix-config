# name: btmux
# url: https://github.com/buntec/btmux
# Named ANSI colors only: btmux maps its base16/base24 scheme onto them, so
# this follows the btmux theme, including live changes.

fish_color_normal --reset
fish_color_autosuggestion brblack
fish_color_cancel --reverse
fish_color_command blue
fish_color_comment brblack --italics
fish_color_cwd green
fish_color_cwd_root red
fish_color_end magenta
fish_color_error red
fish_color_escape cyan
fish_color_history_current --bold
fish_color_host --reset
fish_color_host_remote yellow
fish_color_keyword magenta
fish_color_operator cyan
fish_color_param --reset
fish_color_quote green
fish_color_redirection cyan
fish_color_search_match --background=brblack --bold
fish_color_selection --background=brblack --bold
fish_color_status red
fish_color_user brgreen
fish_color_valid_path --underline
fish_pager_color_completion --reset
fish_pager_color_description yellow --italics
fish_pager_color_prefix --bold --underline
fish_pager_color_progress cyan --reverse --bold
fish_pager_color_selected_background --reverse
